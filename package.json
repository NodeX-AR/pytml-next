{
  "name": "pytml",
  "version": "3.0.0-alpha.1",
  "description": "Pytml: beginner-friendly Python + HTML with an independent CPython WebAssembly runtime.",
  "type": "module",
  "main": "src/pytml.js",
  "exports": { ".": "./src/pytml.js" },
  "scripts": {
    "test": "node --test tests/*.test.js",
